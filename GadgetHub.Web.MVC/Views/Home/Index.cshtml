@{
    ViewData["Title"] = "Home";
    Layout = null;

}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/GadgetHub.Web.MVC.styles.css" asp-append-version="true" />
<div class="text-center d-flex justify-content-center align-items-center flex-column" style="height: 100vh;">
    <h1 class="display-4">Welcome to GadgetHub</h1>
    <p class="lead">Your one-stop shop for amazing gadgets!</p>

    @if (string.IsNullOrEmpty(Context.Session.GetString("JWTToken")))
    {
        <div class="mt-4">
            <a href="/Login/Login" class="btn btn-primary btn-lg me-3">Login</a>
            <a href="/Register/Register" class="btn btn-outline-primary btn-lg">Register</a>
        </div>
    }
    else
    {
        <div class="mt-4">
            <a href="/Product" class="btn btn-success btn-lg">View Products</a>
        </div>
    }
</div>